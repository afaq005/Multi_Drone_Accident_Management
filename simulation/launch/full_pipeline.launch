<?xml version="1.0"?>
<!--
  simulation/launch/full_pipeline.launch
  ========================================
  Brings up the complete agentic pipeline described in Fig. 1 / Section 6:
  MAVROS bridges for the 4-drone fleet, per-drone GNC flight controllers,
  per-drone perception agents, the coordination agent, and the planning
  agent's ROS wrapper. The dispatch/description agents are triggered
  reactively (see description_agent/inference.py, dispatch_agent/tts_dispatch.py)
  rather than run as long-lived ROS nodes, but can be wrapped the same way.

  Prerequisite: Gazebo + start_sitl_fleet.sh already running with
  worlds/four_accident_sites.world loaded.
-->
<launch>
  <include file="$(find multi_drone_accident_management)/simulation/launch/mavros_bridge.launch" />

  <!-- Per-drone GNC flight controllers (Section 6.3) -->
  <node pkg="multi_drone_accident_management" type="gnc_node.py" name="gnc_drone1"
        args="--namespace /drone1" output="screen" />
  <node pkg="multi_drone_accident_management" type="gnc_node.py" name="gnc_drone2"
        args="--namespace /drone2" output="screen" />
  <node pkg="multi_drone_accident_management" type="gnc_node.py" name="gnc_drone3"
        args="--namespace /drone3" output="screen" />
  <node pkg="multi_drone_accident_management" type="gnc_node.py" name="gnc_drone4"
        args="--namespace /drone4" output="screen" />

  <!-- Per-drone perception agents (Section 6.4, Eq. 21-22) -->
  <node pkg="multi_drone_accident_management" type="inference_node.py" name="perception_drone1"
        args="--namespace /drone1" output="screen" />
  <node pkg="multi_drone_accident_management" type="inference_node.py" name="perception_drone2"
        args="--namespace /drone2" output="screen" />
  <node pkg="multi_drone_accident_management" type="inference_node.py" name="perception_drone3"
        args="--namespace /drone3" output="screen" />
  <node pkg="multi_drone_accident_management" type="inference_node.py" name="perception_drone4"
        args="--namespace /drone4" output="screen" />

  <!-- Coordination agent (Eq. 2) -->
  <node pkg="multi_drone_accident_management" type="coordination_node.py"
        name="coordination_agent" output="screen" />

  <!-- Planning agent (GPT-4o mini, Section 6.2) -->
  <node pkg="multi_drone_accident_management" type="llm_waypoint_node.py"
        name="planning_agent" output="screen" />

</launch>
