<?xml version="1.0" ?>
<!--
  simulation/worlds/four_accident_sites.world
  =============================================
  Custom Gazebo world containing four geographically separated traffic
  accident sites (Section 6.1): "Each accident site contains static
  obstacles (buildings, guardrails) and a moving vehicle, providing
  simultaneous perception, navigation, and collision avoidance."

  This is a minimal, working SDF skeleton intended as a starting point —
  swap the placeholder <include> models for your own accident-scene models
  (vehicles, fire props, guardrails) or Gazebo Fuel models.
-->
<sdf version="1.6">
  <world name="four_accident_sites">

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- ==================== Accident Site 1 ==================== -->
    <model name="accident_site_1_guardrail">
      <static>true</static>
      <pose>-165 -1.43 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.3 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.3 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
      </link>
    </model>
    <include>
      <name>accident_site_1_vehicle</name>
      <uri>model://hatchback</uri>
      <pose>-165 -1.43 0.2 0 0 0.4</pose>
    </include>

    <!-- ==================== Accident Site 2 ==================== -->
    <model name="accident_site_2_guardrail">
      <static>true</static>
      <pose>102.2 4.1 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.3 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.3 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
      </link>
    </model>
    <include>
      <name>accident_site_2_vehicle</name>
      <uri>model://hatchback</uri>
      <pose>102.2 4.1 0.2 0 0 -0.6</pose>
    </include>

    <!-- ==================== Accident Site 3 ==================== -->
    <model name="accident_site_3_guardrail">
      <static>true</static>
      <pose>-40 85 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.3 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.3 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
      </link>
    </model>
    <include>
      <name>accident_site_3_vehicle</name>
      <uri>model://hatchback</uri>
      <pose>-40 85 0.2 0 0 1.1</pose>
    </include>

    <!-- ==================== Accident Site 4 ==================== -->
    <model name="accident_site_4_guardrail">
      <static>true</static>
      <pose>60 -90 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.3 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.3 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material>
        </visual>
      </link>
    </model>
    <include>
      <name>accident_site_4_vehicle</name>
      <uri>model://hatchback</uri>
      <pose>60 -90 0.2 0 0 -1.3</pose>
    </include>

  </world>
</sdf>
